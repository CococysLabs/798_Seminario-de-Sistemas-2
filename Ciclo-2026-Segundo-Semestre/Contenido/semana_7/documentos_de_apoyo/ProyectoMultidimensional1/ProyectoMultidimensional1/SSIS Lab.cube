  <MdxScripts>
    <MdxScript dwd:design-time-name="3cdfa9cb-7b91-4503-843d-8bfd3c4654e2">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].utilidad_calculada
 AS [Measures].[Monto Venta] - [Measures].[Monto Costo], 
FORMAT_STRING = "Currency", 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].nueva_metrica
 AS , 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="6bd0fca3-77c4-4b2d-be31-0da3bf502d53">
      <ID>KPI</ID>
      <Name>Ejemplo_KPI</Name>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Margen %]</Value>
      <Goal>0.30</Goal>
      <Status>CASE
    WHEN IsEmpty([Measures].[Margen %]) THEN NULL
    WHEN [Measures].[Margen %] &gt;= 0.30 THEN 1
    WHEN [Measures].[Margen %] &gt;= 0.20 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN IsEmpty([Measures].[Margen %]) THEN NULL
    WHEN [Measures].[Margen %] &gt;
         ([Measures].[Margen %], ParallelPeriod([DimFecha].[Año], 1)) THEN 1
    WHEN [Measures].[Margen %] =
         ([Measures].[Margen %], ParallelPeriod([DimFecha].[Año], 1)) THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>